PORT=4000
NODE_ENV=development

# Long random string used to sign the session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Origin of the Next.js frontend (needed for CORS + cookies).
FRONTEND_ORIGIN=http://localhost:3000

# bcrypt hash of the Owl-OS admin password.
# Generate it with: npm run hash -- "your-password-here"
# IMPORTANT: if this .env file is consumed by docker-compose's `env_file`,
# use the "$$"-escaped hash the script prints, not the raw bcrypt hash —
# a raw "$" is treated as a shell variable sigil by Compose and corrupts it.
ADMIN_PASSWORD_HASH=
